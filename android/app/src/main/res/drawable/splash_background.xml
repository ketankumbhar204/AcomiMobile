<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_canvas" />
    <!--
      Size and gravity belong on the item. A nested bitmap with gravity="center"
      is drawn at the bottom of the window on current Android versions.
      splash_logo is the white rounded tile + approved mark for the brief native flash.
    -->
    <item
        android:width="118dp"
        android:height="118dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
