# Copy to android/keystore.properties and fill in local values.
# android/keystore.properties is gitignored — never commit real passwords or keystores.
#
# storeFile is resolved relative to the android/ directory (rootProject).
# Example: place the keystore at android/app/acomi-upload.keystore

storeFile=app/acomi-upload.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
